# ============================================================
# 环境变量示例 —— 复制为 .env 后按需修改
#
#   cp .env.example .env
#
# 两种用法（同一个文件都支持）：
#   1) 非 Docker（npm start / node proxy.mjs）：程序会自己读取项目根目录的 .env
#   2) Docker compose：compose 会读同目录的 .env 并注入容器
#
# 优先级（从高到低）：真实环境变量 > .env > data/settings.json（后台写入）
#                     > config.json > 内置默认值
# 也就是说：**已在 shell 里 export 的同名变量会压过 .env**（这是刻意的）。
#
# ⚠️ .env 里有密码与上游 Key，已被 .gitignore 与 .dockerignore 排除，别手动提交。
# ============================================================

# ---- 管理后台 ----
# 后台访问密码。未设置时 /admin/ 整体拒绝访问（不是「无密码可进」）。
# 登录后可在后台「设置」页改密码，改完写入 data/.admin-auth.json，优先级高于这里。
ADMIN_PASSWORD=changeme-use-a-strong-password

# 给会话 Cookie 加 Secure（仅当你自己在前端套了 HTTPS 时才需要；http:// 下开启会导致登录不上）
# ADMIN_COOKIE_SECURE=1

# ---- 数据面访问凭证（二选一，都留空则为「透传模式」）----
# 方式 A（推荐）：不在这里配，去后台「🔐 2API Key」页签发 —— 可按客户端逐个签发/吊销
# 方式 B：单个共享口令（旧配置兼容）
# PROXY_KEY=

# ---- 上游 Key（Command Code 账号密钥，user_ 开头）----
# 一般不需要在这里配：去后台「🔑 上游 Key」页添加更灵活（可一键停用/启用）。
# 配在这里的会以「只读」条目出现在后台，可在后台「导入」为可管理条目。
# 多个用英文逗号分隔。
# CC_API_KEY=user_xxxxxxxxx,user_yyyyyyyyy

# ---- 服务监听 ----
# 容器内端口固定 3050（Dockerfile 已写死，改这里不影响容器内）；裸机运行可改
PORT=3050
HOST=0.0.0.0

# ---- 上游与代理 ----
# 上游地址（一般不用改）
# CC_API_BASE=https://api.commandcode.ai
# 让「发往 Command Code 的请求」走本地 HTTP 代理（仅支持 http://）
# CC_UPSTREAM_PROXY=http://127.0.0.1:7890
# 请求的展示项目名
# PROJECT_SLUG=cc-proxy

# ---- 数据与日志 ----
# 运行时数据目录（上游 Key / 2API Key / 后台密码 / 模型启停状态）。默认 <项目>/data
# ⚠️ Docker 部署必须把它挂卷，否则容器重建后后台配置全丢
# CC_DATA_DIR=/app/data
# 日志级别：debug / info / warn / error
# CC_LOG_LEVEL=info
# 日志文件（留空只输出到控制台）
# LOG_FILE=
# 容器内端口固定，不要改（容器编排依赖它）
# CC_KEEPALIVE_TIMEOUT_MS=65000

# ---- 模型目录 ----
# 是否从上游动态拉取模型列表（默认 true）
# CC_USE_PROVIDER_MODELS=true

# ---- 反检测相关（一般不用动）----
# 成批更换设备身份用的盐
# CC_FINGERPRINT_SALT=
# 伪装的项目目录
# CC_DEVICE_PROJECT_DIR=
# 无 system prompt 时发空格占位，阻止上游注入约 7.5K 默认提示词
# CC_EMPTY_SYSTEM_PLACEHOLDER=true
# 请求 ZDR-only 路由
# CMD_ZDR=0

# ---- 容量与超时（按需）----
# 请求体上限（MB），超限返回 413。注意内存放大：单个请求最坏可吃「上限 × ~5.5」
# CC_MAX_BODY_MB=100
# 进程内在途请求上限，超限返回 503（0 = 不限）
# CC_MAX_INFLIGHT=0
# 流式 / 非流式上游读空闲超时（毫秒）
# CC_STREAM_IDLE_MS=30000
# CC_NONSTREAM_IDLE_MS=90000
# 下游背压阻塞超过该毫秒数就断开该客户端（留空禁用）
# CC_CLIENT_DRAIN_TIMEOUT_MS=

# ---- Docker 编排专用（仅 compose 读取，不注入容器）----
# 宿主机映射端口
# PROXY_PORT=3050
