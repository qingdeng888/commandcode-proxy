{
  "name": "commandcode-proxy",
  "version": "1.1.0",
  "type": "module",
  "description": "Command Code → OpenAI 兼容代理",
  "license": "MIT",
  "main": "proxy.mjs",
  "scripts": {
    "start": "node proxy.mjs",
    "dev": "node --watch --watch-path=./proxy.mjs --watch-path=./config.json --watch-path=./lib proxy.mjs",
    "test": "node --test test/*.test.mjs",
    "build:web": "npm --prefix web install --no-audit --no-fund && npm --prefix web run build",
    "dev:web": "npm --prefix web run dev",
    "docker:build": "docker build -t commandcode-proxy:latest .",
    "docker:build:multi": "docker buildx build --platform linux/amd64,linux/arm64 -t commandcode-proxy:latest ."
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
